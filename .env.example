# Supabase Cloud Configuration (PostgreSQL Database)
NEXT_PUBLIC_SUPABASE_URL=https://kqkggjsjwbkodqyeddwj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_lszD_-UWYQ6hhL9cvEyCIA_c3ZHXSCc
SUPABASE_URL=https://kqkggjsjwbkodqyeddwj.supabase.co
SUPABASE_ANON_KEY=sb_publishable_lszD_-UWYQ6hhL9cvEyCIA_c3ZHXSCc

# Database Driver: "postgres" (default Supabase), "sqlite", or "d1"
DB_DRIVER=postgres

# Ingestion Security (Required for POST /api/ingest)
INGEST_TOKEN=act_smartcity_ingest_secret_token_2026

# Settings Security (Required for PATCH /api/settings and GET /api/audit)
SETTINGS_TOKEN=act_smartcity_settings_secret_token_2026

# Device Control & Audit Log (Required for POST /api/control)
CONTROL_TOKEN=act_operator_secret_token_2026
OPERATOR_NAME=ACT_Admin
CONTROL_OPERATORS_JSON={"ACT_Admin":"act_operator_secret_token_2026","Security_Center":"act_security_token_2026"}

# Offline Threshold (Seconds without telemetry before marking device offline)
OFFLINE_AFTER_SECONDS=120

# Assumption College Thonburi — Smart City Dashboard
# Environment Configuration

# Database driver: "sqlite" (default) or "d1"
DB_DRIVER=sqlite
# DB_PATH=data/smartcity.db

# Cloudflare D1 (Required only if DB_DRIVER=d1)
# CF_ACCOUNT_ID=
# CF_D1_DATABASE_ID=
# CF_API_TOKEN=

# Ingestion Security (Required for POST /api/ingest in Live Mode)
INGEST_TOKEN=act_smartcity_ingest_secret_token_2026

# Settings Security (Required for PATCH /api/settings and GET /api/audit)
SETTINGS_TOKEN=act_smartcity_settings_secret_token_2026

# Device Control & Audit Log (Required for POST /api/control)
CONTROL_TOKEN=act_operator_secret_token_2026
OPERATOR_NAME=ACT_Admin
# Multi-operator JSON mapping (alternative to single CONTROL_TOKEN):
# CONTROL_OPERATORS_JSON={"admin":"act_secret_admin_99","security_team":"act_secret_sec_88"}

# Hardware Command Adapter (Target endpoint for real device commands)
# DEVICE_COMMAND_URL=https://adapter.smartcity.act.ac.th/api/commands
# DEVICE_COMMAND_TOKEN=adapter_secret_token_2026

# Offline Threshold (Seconds without telemetry before marking device offline in Live mode)
OFFLINE_AFTER_SECONDS=120

# Supabase SSR (Optional / Future Authentication & Cloud Sync)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...

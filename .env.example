# ==============================================================================
# Assumption College Thonburi — Smart City Dashboard
# Environment Configuration Template (.env.example)
# ==============================================================================

# Supabase Cloud Configuration (PostgreSQL Database)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
RFID_ADMIN_TOKEN=YOUR_LONG_RANDOM_RFID_ADMIN_TOKEN

# Database Driver: "postgres" (default Supabase), "sqlite", or "d1"
DB_DRIVER=postgres

# Ingestion Security (Required for POST /api/ingest)
INGEST_TOKEN=YOUR_LONG_RANDOM_INGEST_TOKEN

# Settings Security (Required for PATCH /api/settings and GET /api/audit)
SETTINGS_TOKEN=YOUR_LONG_RANDOM_SETTINGS_TOKEN

# Device Control & Audit Log (Required for POST /api/control)
CONTROL_TOKEN=YOUR_LONG_RANDOM_CONTROL_TOKEN
OPERATOR_NAME=ACT_Admin
CONTROL_OPERATORS_JSON={"ACT_Admin":"YOUR_LONG_RANDOM_OPERATOR_TOKEN"}

# Offline Threshold (Seconds without telemetry before marking device offline)
OFFLINE_AFTER_SECONDS=120
